# Path to the local LLM weights/runtime (see docs/ADR/0001-local-llm-runtime.md)
LOCAL_MODEL_PATH=

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# fixed | sentence
CHUNKING_STRATEGY=fixed

# Embedding model (sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector search
# brute-force | ivf
INDEX_TYPE=brute-force
NPROBE=8

# Logging
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Groq API key (temporary, until the local LLM runtime lands — see #25)
GROQ_API_KEY=
