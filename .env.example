# Local LLM (llama.cpp, see docs/ADR/0001-local-llm-runtime.md)
# Path to the GGUF weights. Download the default model with:
#   poetry run hf download bartowski/Llama-3.2-3B-Instruct-GGUF Llama-3.2-3B-Instruct-Q4_K_M.gguf --local-dir models
LOCAL_MODEL_PATH=models/Llama-3.2-3B-Instruct-Q4_K_M.gguf
# Context window in tokens (prompt + answer)
LLM_CONTEXT_SIZE=4096
# Maximum number of tokens generated per answer
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.2
# Tokens kept free for the chat template around the prompt. When the prompt
# would not fit in LLM_CONTEXT_SIZE - LLM_MAX_TOKENS - LLM_CONTEXT_MARGIN,
# the least relevant chunks, then the oldest history, are left out
LLM_CONTEXT_MARGIN=64
# CPU threads used for inference. 0 = automatic
LLM_THREADS=0
# Previous question/answer exchanges recalled in the prompt. 0 = none
HISTORY_TURNS=3
# Minimum cosine similarity for a retrieved chunk to be used as context. When
# no chunk reaches it, the agent says so instead of asking the LLM
MIN_RELEVANCE_SCORE=0.25

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# fixed | sentence
CHUNKING_STRATEGY=fixed

# Embedding model (sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Where embeddings are cached (keyed by chunk id, one file per model).
# Leave empty to disable the on-disk cache.
EMBEDDING_CACHE_DIR=.cache/embeddings

# Vector store
# Directory holding the persisted embeddings + chunk metadata. An existing
# store is loaded on startup and new chunks are appended to it.
# Leave empty to keep the store in memory only.
VECTOR_STORE_PATH=vector_db

# Vector search
# brute-force | ivf | hnsw
INDEX_TYPE=brute-force
NPROBE=8
# With INDEX_TYPE=ivf or hnsw, stores smaller than this keep searching by brute force
# (exact, and still fast at that size) and build no index; the index is built
# once the store reaches it. 0 = always use the index
IVF_MIN_VECTORS=10000
# HNSW graph (INDEX_TYPE=hnsw): links per node, search width when inserting
# (graph quality) and per query (recall/latency trade-off)
HNSW_M=16
HNSW_EF_CONSTRUCTION=100
HNSW_EF_SEARCH=64
# Number of IVF lists (k-means centroids). 0 = automatic, ~sqrt(number of vectors)
IVF_NLIST=0
# New chunks are filed into the existing IVF lists without re-running k-means.
# Once this fraction of the index was added that way, it is fully rebuilt.
IVF_REBUILD_THRESHOLD=0.2

# Web ingestion
# URLs resolving to loopback, private, link-local or reserved addresses are
# refused (SSRF protection), including after redirects. Set to true only to
# ingest pages from your own network.
ALLOW_PRIVATE_URLS=false

# API
# Maximum request body size in MB (uploads included). Larger requests are
# refused with 413 before being written to disk
MAX_UPLOAD_MB=20

# Logging
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
